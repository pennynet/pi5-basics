#!/usr/bin/env bash
set -u
echo "=== Raspberry Pi Status ==="
printf 'Modell: '; tr -d '\0' </proc/device-tree/model 2>/dev/null || echo unbekannt
printf 'OS: '; . /etc/os-release; echo "${PRETTY_NAME:-unbekannt}"
echo
echo "-- Uptime / Load --"; uptime
echo
echo "-- RAM --"; free -h
echo
echo "-- Speicher --"; lsblk -o NAME,TYPE,SIZE,FSTYPE,MOUNTPOINTS,MODEL
echo
echo "-- Netzwerk --"
if command -v ip >/dev/null 2>&1; then
  network_info="$(ip -brief address 2>/dev/null)"
else
  network_info=""
fi
if [ -n "$network_info" ]; then
  printf '%s\n' "$network_info"
else
  network_ips="$(hostname -I 2>/dev/null | xargs)"
  if [ -n "$network_ips" ]; then
    printf 'IP-Adresse(n): %s\n' "$network_ips"
  else
    echo "Keine Netzwerkadresse ermittelbar (iproute2/Verbindung prüfen)."
  fi
fi
echo
echo "-- Temperatur --"
temp_output=""
if command -v vcgencmd >/dev/null 2>&1; then
  temp_output="$(vcgencmd measure_temp 2>/dev/null || true)"
fi
if printf '%s' "$temp_output" | grep -Eq "temp=[0-9]+([.][0-9]+)?'C"; then
  printf '%s\n' "$temp_output"
elif [ -r /sys/class/thermal/thermal_zone0/temp ]; then
  awk '{printf "%.1f °C\n",$1/1000}'
else
  echo "Temperatur nicht verfügbar (vcgencmd und thermal_zone0 fehlgeschlagen)."
fi
echo
echo "-- ZRAM --"; swapon --show 2>/dev/null || true
echo
echo "-- Funkstatus --"; rfkill list 2>/dev/null || true
