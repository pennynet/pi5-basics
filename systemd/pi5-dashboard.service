[Unit]
Description=pi5-basics LAN Dashboard
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi5dashboard
Group=pi5dashboard
WorkingDirectory=/opt/pi5-basics-dashboard
ExecStart=/usr/bin/python3 /opt/pi5-basics-dashboard/app.py
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadOnlyPaths=/etc/os-release /proc /sys
ReadWritePaths=/var/lib/pi5-dashboard /home/pi/.ssh

[Install]
WantedBy=multi-user.target
