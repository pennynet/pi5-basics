[Unit]
Description=pi5-basics interactive LAN terminal backend
After=network.target nginx.service
Wants=network.target

[Service]
Type=simple
User=pi5terminal
Group=pi5terminal
WorkingDirectory=/home/pi5terminal
ExecStart=/usr/local/bin/ttyd --interface 127.0.0.1 --port 7682 --auth-header X-Forwarded-User --writable --max-clients 1 /bin/bash --login
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
